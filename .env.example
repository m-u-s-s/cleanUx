SUBSCRIPTIONS_BILLING_DRIVER=mock
SUBSCRIPTIONS_TRIAL_DAYS=14
SUBSCRIPTIONS_ALLOW_TRIAL_EXTENSION=false
SUBSCRIPTIONS_GRACE_DAYS=3
SUBSCRIPTIONS_AUTO_CANCEL_DAYS=14
SUBSCRIPTIONS_MAX_FAILED=3
SUBSCRIPTIONS_DEFAULT_CURRENCY=EUR
SUBSCRIPTIONS_MAX_PAUSE_DAYS=30
SUBSCRIPTIONS_STRIPE_CAPTURE_METHOD=automatic
SUBSCRIPTIONS_STRIPE_DESCRIPTOR=CleanUx

# ─────────────────────────────────────────
# API Tokens v2
# ─────────────────────────────────────────
API_TOKENS_V2_ENABLED=true
API_TOKEN_RATE_LIMIT_PM=60
API_TOKEN_ADMIN_RATE_LIMIT_PM=120
API_TOKEN_DEFAULT_EXPIRY_DAYS=365
API_TOKEN_ROTATION_GRACE_HOURS=24
API_TOKEN_AUDIT_ENABLED=true
API_TOKEN_AUDIT_SAMPLE_RATE=1.0
API_TOKEN_AUDIT_RETENTION_DAYS=90

# ─────────────────────────────────────────
# Audit v2
# ─────────────────────────────────────────
AUDIT_ENABLED=true
AUDIT_MIRROR_LEGACY=true
AUDIT_MAX_CONTEXT_BYTES=8192
AUDIT_PURGE_BATCH=1000
AUDIT_PURGE_MAX_SECONDS=120

# ─────────────────────────────────────────
# Contracts v2
# ─────────────────────────────────────────
CONTRACTS_DEFAULT_VERSION=1.0
CONTRACTS_PDF_ENGINE=dompdf
CONTRACTS_PDF_DISK=local
CONTRACTS_PDF_PATH=contracts/pdf
CONTRACTS_SIGNATURE_REQUIRED=true
