PRICING_DEFAULT_CURRENCY=EUR
PRICING_AB_ENABLED=true
PRICING_QUOTE_RATE_LIMIT=120
SURGE_MAX_MULTIPLIER=2.5
SURGE_TTL_SECONDS=300
