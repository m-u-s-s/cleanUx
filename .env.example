CHAT_MAX_MESSAGE_LENGTH=4000
CHAT_ATTACHMENTS_ENABLED=true
CHAT_ATTACHMENTS_DISK=public
CHAT_ATTACHMENTS_PATH=chat
CHAT_MAX_ATTACHMENT_KB=5120
CHAT_PII_REDACTION=true
CHAT_TOXIC_BLOCK=true
CHAT_BROADCAST_ENABLED=false
CHAT_AUTO_ARCHIVE_DAYS=30
CHAT_AUTO_CLOSE_BOOKING_COMPLETED=true

# ─────────────────────────────────────────
# Cancellation v2
# ─────────────────────────────────────────
CANCELLATION_DEFAULT_CURRENCY=EUR
CANCELLATION_REFUND_METHOD=stripe
CANCELLATION_NOTIFY_PROVIDER=true
CANCELLATION_NOTIFY_CLIENT=true
CANCELLATION_INTEG_STRIPE=true
CANCELLATION_INTEG_LOYALTY=true
CANCELLATION_INTEG_PROMO=true
