ACCOUNTING_V2_ENABLED=true
ACCOUNTING_DEFAULT_COUNTRY=FR
ACCOUNTING_AUTO_POST=true
ACCOUNTING_EXPORT_DISK=local
ACCOUNTING_EXPORT_PATH=exports/accounting
