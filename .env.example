# ─────────────────────────────────────────
# CleanUx business defaults
# ─────────────────────────────────────────
CLEANUX_EMPLOYEE_HOURLY_COST=15
CLEANUX_TRAVEL_COST=5
CLEANUX_MATERIAL_COST_RATE=0.10
CLEANUX_PLATFORM_FEE_PERCENT=20
# Taux unique au lancement. Mettre à true pour réactiver les taux négociés par
# prestataire (ProviderProfile.commission_rate) — à n'activer qu'une fois la
# compta alignée (le calcul alimente aussi la charge Stripe réelle).
CLEANUX_USE_NEGOTIATED_COMMISSION=false
CLEANUX_SEED_PROFILE=
CLEANUX_SEED_DEFAULT_PROFILE=dev

# ─────────────────────────────────────────
# Sanctum (API tokens)
# ─────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SANCTUM_TOKEN_PREFIX=
