MARKETING_EMAIL_PER_MIN=60
MARKETING_SMS_PER_MIN=20
MARKETING_PUSH_PER_MIN=60
MARKETING_AB_TEST_ENABLED=true

# ─────────────────────────────────────────
# Matching v2 (dispatch scoring)
# ─────────────────────────────────────────
MATCHING_VERSION=v2
MATCHING_TOP_N=5
MATCHING_W_RATING=0.20
MATCHING_W_ACCEPTANCE=0.15
MATCHING_W_COMPLETION=0.15
MATCHING_W_RESPONSE=0.10
MATCHING_W_ZONE=0.10
MATCHING_W_WORKLOAD=0.10
MATCHING_W_AFFINITY=0.10
MATCHING_W_TRADE=0.05
MATCHING_W_RECENCY=0.05
