RISK_BLOCK_THRESHOLD=80
RISK_HOLD_MINUTES=60
RISK_FLAGGED_NETWORKS=

# ─────────────────────────────────────────
# Marketing automation
# ─────────────────────────────────────────
MARKETING_ENABLED=true
