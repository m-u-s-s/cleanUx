# ═══════════════════════════════════════════════════════════════════
# CleanUx — .env.example
# Copier vers .env et compléter les valeurs. Toutes les vars vides
# tomberont sur les defaults config/* (souvent mock/safe).
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
APP_NAME=CleanUx
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR
ASSET_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_SLACK_WEBHOOK_URL=
LOG_STDERR_FORMATTER=

# ─────────────────────────────────────────
# Database
# ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cleanux
DB_USERNAME=root
DB_PASSWORD=root
DB_FOREIGN_KEYS=true

# ─────────────────────────────────────────
# Cache / Queue / Session
# ─────────────────────────────────────────
BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
CACHE_PREFIX=
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
QUEUE_FAILED_DRIVER=database-uuids
QUEUE_HIGH=payments,stripe
QUEUE_DEFAULT=default,notifications
QUEUE_LOW=analytics,reports
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ─────────────────────────────────────────
# Mail (transactional)
# ─────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────
# AWS S3 / cloud storage
# ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─────────────────────────────────────────
# CDN (optional — separate S3-compatible bucket for public assets)
# ─────────────────────────────────────────
CDN_AWS_ACCESS_KEY_ID=
CDN_AWS_SECRET_ACCESS_KEY=
CDN_AWS_DEFAULT_REGION=eu-west-1
CDN_BUCKET=
CDN_URL=

# ─────────────────────────────────────────
# Broadcast (Reverb / Pusher / Ably)
# ─────────────────────────────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER=
REVERB_SCALING_ENABLED=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

ABLY_KEY=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# ─────────────────────────────────────────
# OpsCenter — heartbeat / backups
# ─────────────────────────────────────────
OPS_HEARTBEAT_ENABLED=true
OPS_HEARTBEAT_DISK=local
OPS_HEARTBEAT_PATH=ops/heartbeat.json
OPS_HEARTBEAT_CACHE_KEY=cleanux:ops:heartbeat
OPS_HEARTBEAT_MAX_AGE_SECONDS=300
OPS_BACKUP_ENABLED=true
OPS_BACKUP_DISK=local
OPS_BACKUP_PATH=backups
OPS_BACKUP_RETENTION_DAYS=14
OPS_MONITORING_NOTIFY_EMAIL=
OPS_FAILED_JOBS_WARNING_THRESHOLD=20
OPS_QUEUE_BACKLOG_WARNING_THRESHOLD=200
OPS_REQUIRE_HTTPS_APP_URL=false

# ─────────────────────────────────────────
# Stripe (paiement principal)
# ─────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=

# Premium Plans — Create products in Stripe Dashboard -> Products -> Add product
# Then copy the Price IDs here. See docs/STORES_SUBMISSION_RUNBOOK.md
STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_REPLACE
STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly_REPLACE
STRIPE_BUSINESS_MONTHLY_PRICE_ID=price_biz_monthly_REPLACE
STRIPE_BUSINESS_YEARLY_PRICE_ID=price_biz_yearly_REPLACE

# ─────────────────────────────────────────
# LLM / Assistant
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TIMEOUT=30
ANTHROPIC_RETRIES=1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ASSISTANT_RATE_PER_HOUR=20
ASSISTANT_RATE_PER_DAY=200
ASSISTANT_COST_LIMIT_USD_PER_DAY=10

# ─────────────────────────────────────────
# Messaging (in-app chat upload limits)
# ─────────────────────────────────────────
MESSAGING_ATTACHMENTS_DISK=public
MESSAGING_MAX_SIZE_BYTES=26214400
MESSAGING_AV_REQUIRED=true
MESSAGING_AV_ENGINE=

# ─────────────────────────────────────────
# Web Push (browser notifications)
# ─────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ─────────────────────────────────────────
# SMS v2 (Twilio / Vonage) — REQUIS pour OTP en prod
# ─────────────────────────────────────────
SMS_ENABLED=true
SMS_PROVIDER=mock
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_WEBHOOK_TOKEN=
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=
VONAGE_SIGNATURE_SECRET=
SMS_DEFAULT_SENDER=
SMS_MAX_PER_PHONE_PER_HOUR=5
SMS_MAX_PER_PHONE_PER_DAY=20
SMS_MAX_PER_USER_PER_HOUR=10
SMS_OTP_LENGTH=6
SMS_OTP_EXPIRES_MINUTES=10
SMS_OTP_MAX_ATTEMPTS=5
SMS_OTP_COOLDOWN_SECONDS=60

# ─────────────────────────────────────────
# Push v2 (FCM / APNs) — REQUIS pour mobile en prod
# ─────────────────────────────────────────
PUSH_ENABLED=true
PUSH_PROVIDER=mock
FCM_CREDENTIALS_PATH=
FCM_PROJECT_ID=
FCM_HTTP_TIMEOUT=10
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.cleanux.app
APNS_ENVIRONMENT=sandbox
PUSH_MAX_PER_TOKEN_PER_MINUTE=10
PUSH_MAX_PER_USER_PER_MINUTE=20
PUSH_TOKEN_STALE_AFTER_DAYS=90

# ─────────────────────────────────────────
# KYC (Onfido / Veriff / SumSub)
# ─────────────────────────────────────────
KYC_ENABLED=true
KYC_PROVIDER=mock
ONFIDO_API_TOKEN=
ONFIDO_REGION=eu
ONFIDO_WEBHOOK_TOKEN=
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
KYC_AUTO_APPROVE=false
KYC_MIN_SCORE=70
KYC_MAX_WAIT_HOURS=48

# ─────────────────────────────────────────
# KYB v2 (B2B verification)
# ─────────────────────────────────────────
KYB_IDENTITY_PROVIDER=mock
KYB_VAT_PROVIDER=mock
KYB_SANCTIONS_PROVIDER=mock
INSEE_API_KEY=
COMPANIES_HOUSE_API_KEY=
KVK_API_KEY=
KYB_DEFAULT_COUNTRY=FR
KYB_VERIFICATION_CACHE_DAYS=90
KYB_SANCTIONS_CACHE_DAYS=30
KYB_AUTO_APPROVE=false
KYB_AUTO_APPROVE_SCORE_MAX=15
KYB_MAX_DOC_KB=10240
KYB_DOC_DISK=local
KYB_DOC_PATH=kyb

# ─────────────────────────────────────────
# Insurance (Hiscox / Wakam)
# ─────────────────────────────────────────
INSURANCE_ENABLED=true
INSURANCE_PROVIDER=mock
INSURANCE_DEFAULT_CURRENCY=EUR
HISCOX_API_KEY=
HISCOX_PARTNER_ID=
HISCOX_WEBHOOK_SECRET=
HISCOX_BASE_URL=https://api.hiscox.com/v1
WAKAM_API_KEY=
WAKAM_WEBHOOK_SECRET=
WAKAM_BASE_URL=https://api.wakam.io/v1
INSURANCE_CLAIM_WINDOW_DAYS=30
INSURANCE_CLAIM_MAX_FACTOR=2
INSURANCE_CANCEL_WITH_BOOKING=true

# ─────────────────────────────────────────
# Geolocation v2 (Google Maps / Mapbox)
# ─────────────────────────────────────────
GEO_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
# Alias used by services.google.maps_key for Distance Matrix API
GOOGLE_MAPS_KEY=
GOOGLE_MAPS_LANGUAGE=fr
MAPBOX_ACCESS_TOKEN=
GEO_DEFAULT_COUNTRY=FR
GEO_CACHE_TTL_MIN=10080
GEO_DISTANCE_CACHE_TTL_MIN=1440
GEO_AUTOCOMPLETE_CACHE_TTL_MIN=720
GEO_TIMEOUT_SECONDS=10
GEO_CONNECT_TIMEOUT_SECONDS=5

# ─────────────────────────────────────────
# FX (currency exchange)
# ─────────────────────────────────────────
FX_ENABLED=true
FX_PROVIDER=mock
FX_BASE_CURRENCY=EUR
FX_ECB_FEED_URL=https://www.ecb.europa.eu/stats/eurofxref/eurofxref-daily.xml
FX_OPENEXCHANGE_APP_ID=
FX_OPENEXCHANGE_BASE_URL=https://openexchangerates.org/api
FX_HTTP_TIMEOUT=10
FX_CACHE_TTL_MIN=60
FX_STALE_WARNING_HOURS=24
FX_STALE_BLOCK_HOURS=72
FX_FEE_PERCENT=0

# ─────────────────────────────────────────
