# ═══════════════════════════════════════════════════════════════════
# Brio — .env.staging.example
# Copier vers .env sur serveur staging et renseigner toutes les CHANGE_ME.
#
# DIFFÉRENCES vs production :
#   - APP_ENV=staging, APP_DEBUG=true (traces visibles)
#   - APP_URL pointe vers staging.brio.be
#   - LOG_LEVEL=debug (logs verbeux)
#   - Stripe utilise les clés TEST (sk_test_ / pk_test_)
#   - SMS_ENABLED=false (évite d'envoyer de vrais SMS)
#   - KYC_PROVIDER=mock, INSURANCE_PROVIDER=mock, PUSH_PROVIDER=mock
#   - Sentry traces_sample_rate=1.0 (tout capturer en staging)
#   - SESSION_SECURE_COOKIE=false si staging sur HTTP
#   - BRIO_SEED_DEFAULT_PROFILE=staging
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
APP_NAME="Brio Staging"
APP_ENV=staging
APP_KEY=CHANGE_ME_php_artisan_key:generate
# APP_DEBUG=true permet d'afficher les stack traces — ne jamais activer en prod
APP_DEBUG=true
APP_URL=https://staging.brio.be
ASSET_URL=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
# debug en staging pour diagnostiquer les problèmes avant la mise en prod
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# ─────────────────────────────────────────
# Database (staging : MySQL/MariaDB dédié)
# ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=CHANGE_ME_staging_db_host
DB_PORT=3306
DB_DATABASE=brio_staging
DB_USERNAME=brio_staging_user
DB_PASSWORD=CHANGE_ME_staging_password
DB_FOREIGN_KEYS=true

# ─────────────────────────────────────────
# Cache / Queue / Session (staging : Redis)
# ─────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=.brio.be
# Mettre à false si le serveur staging n'a pas HTTPS configuré
SESSION_SECURE_COOKIE=true

REDIS_CLIENT=phpredis
REDIS_HOST=CHANGE_ME_staging_redis_host
REDIS_PASSWORD=CHANGE_ME_staging_redis_password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ─────────────────────────────────────────
# Mail (staging : Mailtrap ou mailgun sandbox)
# ─────────────────────────────────────────
# Utiliser Mailtrap en staging pour intercepter tous les mails
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_mailtrap_user
MAIL_PASSWORD=CHANGE_ME_mailtrap_pass
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=staging@brio.be
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────
# AWS S3 (staging bucket séparé)
# ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=eu-west-3
# Bucket staging séparé — ne jamais pointer vers le bucket prod
AWS_BUCKET=brio-staging-storage
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

FILESYSTEM_DISK=s3

# ─────────────────────────────────────────
# Broadcast Reverb (staging instance)
# ─────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CHANGE_ME_staging_id
REVERB_APP_KEY=CHANGE_ME_staging_key
REVERB_APP_SECRET=CHANGE_ME_staging_secret
REVERB_HOST=ws.staging.brio.be
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SCALING_ENABLED=false

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─────────────────────────────────────────
# SÉCURITÉ
# ─────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://staging.brio.be,capacitor://localhost,ionic://localhost
CORS_SUPPORTS_CREDENTIALS=true

TRUSTED_PROXIES=*

SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin

SANCTUM_EXPIRATION_MINUTES=129600
SANCTUM_STATEFUL_DOMAINS=staging.brio.be

# ─────────────────────────────────────────
# Stripe (TEST keys — NE JAMAIS utiliser les clés live en staging)
# ─────────────────────────────────────────
# Les clés test commencent par sk_test_ et pk_test_
STRIPE_KEY=pk_test_CHANGE_ME
STRIPE_SECRET=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_staging
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_CHANGE_ME_staging
STRIPE_CONNECT_COUNTRY=BE
STRIPE_CONNECT_REFRESH_URL=https://staging.brio.be/dashboard/stripe-connect/refresh
STRIPE_CONNECT_RETURN_URL=https://staging.brio.be/dashboard/stripe-connect/return
STRIPE_PREMIUM_PRICE_ID=price_CHANGE_ME_test

BRIO_PLATFORM_FEE_PERCENT=20

# ─────────────────────────────────────────
# SMS Twilio — désactivé en staging pour éviter les vrais SMS
# ─────────────────────────────────────────
# SMS_ENABLED=false empêche tout envoi réel de SMS pendant les tests
SMS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_SID=ACxxxxx_CHANGE_ME
TWILIO_TOKEN=CHANGE_ME
TWILIO_FROM=+32xxxxxxxxx
TWILIO_VERIFY_SIGNATURE=false
SMS_DEFAULT_SENDER="Brio Staging"

# ─────────────────────────────────────────
# Push — mock en staging (pas de FCM/APNs réels)
# ─────────────────────────────────────────
PUSH_ENABLED=true
# mock évite les vraies notifications push pendant les tests
PUSH_PROVIDER=mock
FCM_CREDENTIALS_PATH=/var/www/brio-staging/secure/fcm-credentials.json
FCM_PROJECT_ID=brio-staging
APNS_KEY_PATH=/var/www/brio-staging/secure/AuthKey_xxx.p8
APNS_KEY_ID=CHANGE_ME
APNS_TEAM_ID=CHANGE_ME
APNS_BUNDLE_ID=com.brio.staging
APNS_ENVIRONMENT=sandbox

VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:tech@brio.be

# ─────────────────────────────────────────
# KYC — mock en staging (pas d'appels Onfido réels)
# ─────────────────────────────────────────
KYC_ENABLED=true
# mock permet de tester le flow KYC sans consommer des crédits Onfido
KYC_PROVIDER=mock
ONFIDO_API_TOKEN=api_sandbox_CHANGE_ME
ONFIDO_REGION=eu
ONFIDO_WEBHOOK_TOKEN=CHANGE_ME
KYC_AUTO_APPROVE=true

# ─────────────────────────────────────────
# KYB B2B — mock en staging
# ─────────────────────────────────────────
KYB_IDENTITY_PROVIDER=mock
KYB_VAT_PROVIDER=mock
KYB_SANCTIONS_PROVIDER=mock
INSEE_API_KEY=CHANGE_ME
COMPANIES_HOUSE_API_KEY=CHANGE_ME
KYB_AUTO_APPROVE=true

# ─────────────────────────────────────────
# Insurance — mock en staging
# ─────────────────────────────────────────
INSURANCE_ENABLED=true
# mock évite les appels vers Hiscox/Wakam pendant les tests
INSURANCE_PROVIDER=mock

# ─────────────────────────────────────────
# Geolocation (Google Maps ou mock)
# ─────────────────────────────────────────
GEO_PROVIDER=google
GOOGLE_MAPS_API_KEY=AIzaSy_CHANGE_ME_staging

# ─────────────────────────────────────────
# FX
# ─────────────────────────────────────────
FX_ENABLED=true
FX_PROVIDER=ecb

# ─────────────────────────────────────────
# LLM Anthropic (optionnel)
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─────────────────────────────────────────
# Sentry (staging — sample rate 100% pour tout capturer)
# ─────────────────────────────────────────
SENTRY_LARAVEL_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME
SENTRY_RELEASE=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_SEND_DEFAULT_PII=false
# 1.0 en staging pour capturer 100% des traces (vs 0.05 en prod)
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# ─────────────────────────────────────────
# Backups (Spatie Backup — staging bucket)
# ─────────────────────────────────────────
OPS_HEARTBEAT_ENABLED=true
OPS_HEARTBEAT_DISK=local
OPS_HEARTBEAT_PATH=ops/heartbeat.json
OPS_HEARTBEAT_MAX_AGE_SECONDS=300
OPS_BACKUP_ENABLED=true
OPS_BACKUP_DISK=s3
OPS_BACKUP_PATH=backups/staging
OPS_BACKUP_RETENTION_DAYS=7
OPS_MONITORING_NOTIFY_EMAIL=ops@brio.be
OPS_FAILED_JOBS_WARNING_THRESHOLD=5
OPS_QUEUE_BACKLOG_WARNING_THRESHOLD=50
OPS_REQUIRE_HTTPS_APP_URL=true

# ─────────────────────────────────────────
# Modules v2
# ─────────────────────────────────────────
ACCOUNTING_V2_ENABLED=true
ACCOUNTING_AUTO_POST=false
ACCOUNTING_FEC_COUNTRY=FR
ACCOUNTING_FEC_SIREN=CHANGE_ME_si_FR

SUBSCRIPTIONS_BILLING_DRIVER=stripe

API_TOKENS_V2_ENABLED=true
AUDIT_ENABLED=true
AUDIT_MIRROR_LEGACY=false
NOTIF_PREFS_ENABLED=true

TENANCY_DEFAULT_TENANT=brio
TENANCY_HEADER=X-Tenant-Code

TIPS_ENABLED=true
TIPS_BONUS_POINTS_PER_EUR=1

TRIP_TRACKING_ENABLED=true
TRIP_TRACKING_GEOFENCE_M=150

PRESENCE_ENABLED=true
PRESENCE_STALE_MIN=5

LOYALTY_ENABLED=true

MARKETING_ENABLED=true

RISK_ENABLED=true
RISK_BLOCK_THRESHOLD=80

CANCELLATION_DEFAULT_CURRENCY=EUR
CANCELLATION_INTEG_STRIPE=true
CANCELLATION_INTEG_LOYALTY=true

CHAT_BROADCAST_ENABLED=true
CHAT_PII_REDACTION=true
CHAT_TOXIC_BLOCK=true

QUALITY_ENABLED=true
QUALITY_PHOTO_DISK=s3
QUALITY_SIGNATURE_REQUIRED=false

# ─────────────────────────────────────────
# Business defaults
# ─────────────────────────────────────────
BRIO_EMPLOYEE_HOURLY_COST=18
BRIO_TRAVEL_COST=8
BRIO_MATERIAL_COST_RATE=0.08
# staging profile charge des données de test, pas les données prod
BRIO_SEED_DEFAULT_PROFILE=staging
