# ═══════════════════════════════════════════════════════════════════
# CleanUx — .env.production.example
# Copier vers .env sur serveur prod et renseigner toutes les CHANGE_ME.
# Validation : php artisan ops:check-providers --strict (doit return 0)
# ═══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────
# Application
# ─────────────────────────────────────────
APP_NAME=CleanUx
APP_ENV=production
APP_KEY=CHANGE_ME_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://app.cleanux.com
ASSET_URL=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# ─────────────────────────────────────────
# Database (PROD : MySQL/MariaDB requis)
# ─────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=CHANGE_ME_db_host
DB_PORT=3306
DB_DATABASE=cleanux_production
DB_USERNAME=cleanux_user
DB_PASSWORD=CHANGE_ME_strong_password
DB_FOREIGN_KEYS=true

# ─────────────────────────────────────────
# Cache / Queue / Session (PROD : Redis recommended)
# ─────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=.cleanux.com
SESSION_SECURE_COOKIE=true

REDIS_CLIENT=phpredis
REDIS_HOST=CHANGE_ME_redis_host
REDIS_PASSWORD=CHANGE_ME_strong_password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ─────────────────────────────────────────
# Mail (Mailgun ou Postmark ou SES recommended)
# ─────────────────────────────────────────
MAIL_MAILER=mailgun
MAILGUN_DOMAIN=mg.cleanux.com
MAILGUN_SECRET=CHANGE_ME
MAILGUN_ENDPOINT=api.eu.mailgun.net
# OU SMTP fallback :
# MAIL_MAILER=smtp
# MAIL_HOST=CHANGE_ME
# MAIL_PORT=587
# MAIL_USERNAME=CHANGE_ME
# MAIL_PASSWORD=CHANGE_ME
# MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@cleanux.com
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────
# AWS S3 (storage + backups)
# ─────────────────────────────────────────
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=cleanux-prod-storage
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

FILESYSTEM_DISK=s3

# ─────────────────────────────────────────
# Broadcast Reverb
# ─────────────────────────────────────────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=CHANGE_ME_random_id
REVERB_APP_KEY=CHANGE_ME_random_key
REVERB_APP_SECRET=CHANGE_ME_random_secret
REVERB_HOST=ws.cleanux.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SCALING_ENABLED=true
REVERB_SCALING_CHANNEL=reverb

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─────────────────────────────────────────
# SÉCURITÉ
# ─────────────────────────────────────────
# CORS : domaines autorisés (CSV) — incl. schemes Capacitor mobile
CORS_ALLOWED_ORIGINS=https://app.cleanux.com,https://www.cleanux.com,capacitor://localhost,ionic://localhost
CORS_SUPPORTS_CREDENTIALS=true

# TrustProxies : "*" pour Cloudflare/ALB, OU liste CIDR
TRUSTED_PROXIES=*

# Security Headers (CSP optionnel — restreindre en prod)
SECURITY_X_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
# SECURITY_CSP="default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://unpkg.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://unpkg.com; connect-src 'self' https://api.stripe.com wss://ws.cleanux.com"

# Sanctum tokens expiration (en minutes — 90j default)
SANCTUM_EXPIRATION_MINUTES=129600
SANCTUM_STATEFUL_DOMAINS=app.cleanux.com,www.cleanux.com

# ─────────────────────────────────────────
# Stripe (paiement principal — REQUIS)
# ─────────────────────────────────────────
STRIPE_KEY=pk_live_CHANGE_ME
STRIPE_SECRET=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_CHANGE_ME
STRIPE_CONNECT_COUNTRY=BE
STRIPE_CONNECT_REFRESH_URL=https://app.cleanux.com/dashboard/stripe-connect/refresh
STRIPE_CONNECT_RETURN_URL=https://app.cleanux.com/dashboard/stripe-connect/return
STRIPE_PREMIUM_PRICE_ID=price_CHANGE_ME

CLEANUX_PLATFORM_FEE_PERCENT=20

# ─────────────────────────────────────────
# SMS Twilio (REQUIS pour OTP)
# ─────────────────────────────────────────
SMS_ENABLED=true
SMS_PROVIDER=twilio
TWILIO_SID=ACxxxxx_CHANGE_ME
TWILIO_TOKEN=CHANGE_ME
TWILIO_FROM=+32xxxxxxxxx
TWILIO_VERIFY_SIGNATURE=true
SMS_DEFAULT_SENDER="CleanUx"

# ─────────────────────────────────────────
# Push FCM/APNs (REQUIS pour mobile native)
# ─────────────────────────────────────────
PUSH_ENABLED=true
PUSH_PROVIDER=fcm
FCM_CREDENTIALS_PATH=/var/www/cleanux/secure/fcm-credentials.json
FCM_PROJECT_ID=cleanux-prod
APNS_KEY_PATH=/var/www/cleanux/secure/AuthKey_xxx.p8
APNS_KEY_ID=CHANGE_ME
APNS_TEAM_ID=CHANGE_ME
APNS_BUNDLE_ID=com.cleanux.app
APNS_ENVIRONMENT=production

# Web Push (browser)
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:tech@cleanux.com

# ─────────────────────────────────────────
# KYC Onfido (REQUIS pour provider verification)
# ─────────────────────────────────────────
KYC_ENABLED=true
KYC_PROVIDER=onfido
ONFIDO_API_TOKEN=api_live_CHANGE_ME
ONFIDO_REGION=eu
ONFIDO_WEBHOOK_TOKEN=CHANGE_ME
KYC_AUTO_APPROVE=false

# ─────────────────────────────────────────
# KYB B2B (INSEE/Companies House)
# ─────────────────────────────────────────
KYB_IDENTITY_PROVIDER=insee
KYB_VAT_PROVIDER=vies
KYB_SANCTIONS_PROVIDER=mock
INSEE_API_KEY=CHANGE_ME
COMPANIES_HOUSE_API_KEY=CHANGE_ME
KYB_AUTO_APPROVE=false

# ─────────────────────────────────────────
# Insurance (Hiscox ou Wakam — optionnel)
# ─────────────────────────────────────────
INSURANCE_ENABLED=true
INSURANCE_PROVIDER=mock
# HISCOX_API_KEY=CHANGE_ME
# HISCOX_WEBHOOK_SECRET=CHANGE_ME
# WAKAM_API_KEY=CHANGE_ME

# ─────────────────────────────────────────
# Geolocation (Google Maps recommended)
# ─────────────────────────────────────────
GEO_PROVIDER=google
GOOGLE_MAPS_API_KEY=AIzaSy_CHANGE_ME

# ─────────────────────────────────────────
# FX (ECB free / OpenExchange paid)
# ─────────────────────────────────────────
FX_ENABLED=true
FX_PROVIDER=ecb
# FX_OPENEXCHANGE_APP_ID=CHANGE_ME

# ─────────────────────────────────────────
# LLM Anthropic (optionnel — chatbot)
# ─────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─────────────────────────────────────────
# Sentry (REQUIS error tracking)
# ─────────────────────────────────────────
SENTRY_LARAVEL_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME
SENTRY_RELEASE=
SENTRY_ENVIRONMENT="${APP_ENV}"
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.05

# ─────────────────────────────────────────
# Backups (Spatie Backup)
# ─────────────────────────────────────────
OPS_HEARTBEAT_ENABLED=true
OPS_HEARTBEAT_DISK=local
OPS_HEARTBEAT_PATH=ops/heartbeat.json
OPS_HEARTBEAT_MAX_AGE_SECONDS=300
OPS_BACKUP_ENABLED=true
OPS_BACKUP_DISK=s3
OPS_BACKUP_PATH=backups
OPS_BACKUP_RETENTION_DAYS=30
OPS_MONITORING_NOTIFY_EMAIL=ops@cleanux.com
OPS_FAILED_JOBS_WARNING_THRESHOLD=20
OPS_QUEUE_BACKLOG_WARNING_THRESHOLD=200
OPS_REQUIRE_HTTPS_APP_URL=true

# ─────────────────────────────────────────
# Modules v2 (modes prod)
# ─────────────────────────────────────────
ACCOUNTING_V2_ENABLED=true
ACCOUNTING_AUTO_POST=true
ACCOUNTING_FEC_COUNTRY=FR
ACCOUNTING_FEC_SIREN=CHANGE_ME_si_FR

SUBSCRIPTIONS_BILLING_DRIVER=stripe

API_TOKENS_V2_ENABLED=true
AUDIT_ENABLED=true
AUDIT_MIRROR_LEGACY=false
NOTIF_PREFS_ENABLED=true

TENANCY_DEFAULT_TENANT=cleanux
TENANCY_HEADER=X-Tenant-Code

# Tips
TIPS_ENABLED=true
TIPS_BONUS_POINTS_PER_EUR=1

# Trip Tracking
TRIP_TRACKING_ENABLED=true
TRIP_TRACKING_GEOFENCE_M=150

# Presence
PRESENCE_ENABLED=true
PRESENCE_STALE_MIN=5

# Loyalty
LOYALTY_ENABLED=true

# Marketing
MARKETING_ENABLED=true

# Risk
RISK_ENABLED=true
RISK_BLOCK_THRESHOLD=80

# Cancellation v2
CANCELLATION_DEFAULT_CURRENCY=EUR
CANCELLATION_INTEG_STRIPE=true
CANCELLATION_INTEG_LOYALTY=true

# Chat v2
CHAT_BROADCAST_ENABLED=true
CHAT_PII_REDACTION=true
CHAT_TOXIC_BLOCK=true

# Quality v2
QUALITY_ENABLED=true
QUALITY_PHOTO_DISK=s3
QUALITY_SIGNATURE_REQUIRED=true

# ─────────────────────────────────────────
# Business defaults
# ─────────────────────────────────────────
CLEANUX_EMPLOYEE_HOURLY_COST=18
CLEANUX_TRAVEL_COST=8
CLEANUX_MATERIAL_COST_RATE=0.08
CLEANUX_SEED_DEFAULT_PROFILE=prod
