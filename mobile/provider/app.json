{
  "expo": {
    "name": "CleanUx Provider",
    "slug": "cleanux-provider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070b14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cleanux.provider",
      "infoPlist": {
        "NSCameraUsageDescription": "CleanUx Provider uses the camera to scan and display QR codes.",
        "NSLocationWhenInUseUsageDescription": "CleanUx Provider uses your location to navigate to clients and share your ETA.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "CleanUx Provider tracks your location during missions to show clients your progress.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070b14"
      },
      "package": "com.cleanux.provider",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "scheme": "cleanux-provider",
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-image-picker",
      "expo-camera",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "CleanUx Provider needs background location to share your position with clients during missions."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e5338332-bd5a-4c98-92fa-fb29212e486b"
      }
    },
    "owner": "m-u-s-s"
  }
}
