{
  "expo": {
    "name": "brio Pro",
    "slug": "cleanux-provider",
    "version": "1.0.0",
    "orientation": "portrait",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.brio.provider",
      "infoPlist": {
        "NSCameraUsageDescription": "brio Provider utilise l'appareil photo pour scanner les codes QR de présence, photographier vos justificatifs et vos missions, et vérifier votre identité par un selfie avant intervention.",
        "NSLocationWhenInUseUsageDescription": "brio Provider uses your location to navigate to clients and share your ETA.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "brio Provider tracks your location during missions to show clients your progress.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#191c20"
      },
      "package": "com.brio.provider",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "scheme": "brio-provider",
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "expo-image-picker",
      "expo-camera",
      [
        "expo-audio",
        {
          "microphonePermission": "brio Provider a besoin du micro pour vos notes vocales et vos appels d'équipe."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "brio Provider needs background location to share your position with clients during missions."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#eeeae0",
          "imageWidth": 200,
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#191c20"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e5338332-bd5a-4c98-92fa-fb29212e486b"
      }
    },
    "owner": "m-u-s-s"
  }
}
