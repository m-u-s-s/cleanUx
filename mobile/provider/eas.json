{
  "cli": { "version": ">= 12.0.0" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.brio.com/api",
        "EXPO_PUBLIC_WEB_URL": "https://staging.brio.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://app.brio.com/api",
        "EXPO_PUBLIC_WEB_URL": "https://app.brio.com"
      }
    }
  }
}
