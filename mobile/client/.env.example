# API address — leave unset in development: the app targets the machine serving Metro, on port
# 8000 (shared/src/config/env.ts), from the emulator and from a phone on the same Wi-Fi alike.
# The server must listen on all interfaces: php artisan serve --host=0.0.0.0 --port=8000
# Metro reached through `adb reverse` (localhost:8081)? Also run: adb reverse tcp:8000 tcp:8000
# `expo start --tunnel` only relays Metro, not the API: set the address explicitly in that case.
# Set it only to target another server; an explicit value always wins.
# EXPO_PUBLIC_API_URL=https://staging.brio.com/api

# Required for Stripe payments
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Sentry crash reporting — get DSN from https://sentry.io/settings/projects/
# Leave empty to disable
EXPO_PUBLIC_SENTRY_DSN=
